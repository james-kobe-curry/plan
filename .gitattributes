# 文本文件统一使用 LF 入库与检出
* text=auto eol=lf

# Windows 批处理需要 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件，不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.wav binary
*.mp3 binary
*.ogg binary
*.m4a binary
*.aac binary
*.jks binary
*.keystore binary
*.apk binary
*.zip binary
*.jar binary
